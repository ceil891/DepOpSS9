# =============================================================================
# Cấu hình Nginx Reverse Proxy cho ứng dụng React Frontend (Port 3000)
# Vị trí file: /etc/nginx/sites-available/default
# Kích hoạt: sudo ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/
# =============================================================================

server {
    # 1. Lắng nghe trên cổng 80 (cổng HTTP tiêu chuẩn) cho cả IPv4 và IPv6
    listen 80 default_server;
    listen [::]:80 default_server;

    # 2. Tên miền ứng dụng (hoặc IP server nếu chưa gắn domain)
    # Có thể khai báo domain cụ thể: server_name domain.com www.domain.com;
    # Hoặc dùng '_' để bắt mọi host header gửi tới IP này
    server_name domain.com www.domain.com;

    # 3. Block location gốc: Định tuyến mọi request tới ứng dụng React (port 3000)
    location / {
        # proxy_pass: Chỉ thị cốt lõi chuyển tiếp request tới ứng dụng React chạy ở port 3000
        proxy_pass http://127.0.0.1:3000;

        # Thiết lập các Header quan trọng nhằm bảo toàn thông tin client
        # Header Host: Giữ nguyên tên miền client đã nhập trong URL
        proxy_set_header Host $host;

        # Header X-Real-IP: Chuyển tiếp địa chỉ IP thực sự của người dùng
        proxy_set_header X-Real-IP $remote_addr;

        # Header X-Forwarded-For: Chuỗi danh sách IP client qua các proxy
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Header X-Forwarded-Proto: Giữ lại giao thức ban đầu (http hoặc https)
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cấu hình hỗ trợ WebSocket (Rất quan trọng đối với React Fast Refresh/HMR và Socket.io)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Thiết lập thời gian chờ kết nối (Timeout)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Cấu hình trang lỗi tùy chỉnh (tùy chọn) khi backend bị lỗi/sập
    error_page 500 502 503 504 /custom_50x.html;
    location = /custom_50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
